# GEMINI_API_KEY: Required for Gemini AI API calls.
# In AI Studio, this is injected automatically from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable model name (defaults to gemini-3.8-flash, with auto-fallback)
GEMINI_MODEL="gemini-3.8-flash"

# DATABASE_URL & DIRECT_URL: Supabase PostgreSQL connection strings (optional for local/persisted storage)
DATABASE_URL="postgresql://postgres:password@localhost:5432/buddy_elder_ai"
DIRECT_URL="postgresql://postgres:password@localhost:5432/buddy_elder_ai"

# JWT_SECRET: Strong 256-bit secret string used to sign and verify JSON Web Tokens.
# Configure this in your backend environment (Google AI Studio Settings > Secrets or production host).
# Generate with: openssl rand -base64 32
JWT_SECRET="YOUR_SECURE_RANDOM_JWT_SECRET_MIN_32_CHARS"

# JWT_EXPIRES_IN: Token expiration duration (defaults to 7 days for seniors: "7d", "24h", "30d")
JWT_EXPIRES_IN="7d"

# APP_URL / FRONTEND_URL: Host address
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# PORT: Server listening port
PORT=3000
